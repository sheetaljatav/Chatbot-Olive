# ----- LLM Providers -----
# At least one must be set. Default provider is selected by PROVIDER.
PROVIDER=gemini                          # gemini | openai | anthropic | ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ----- Service URLs (internal compose hostnames) -----
INGESTION_URL=http://ingestion-api:8001
CHAT_API_URL=http://chat-api:8000
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000

# ----- Postgres -----
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@postgres:5432/chatbot

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
EVENT_STREAM=llm.events
EVENT_DLQ=llm.events.dlq
EVENT_GROUP=workers

# ----- SDK behavior -----
SDK_BATCH_SIZE=20
SDK_FLUSH_INTERVAL_MS=500
SDK_BUFFER_MAX=1000

# ----- PII redaction -----
PII_REDACTION_ENABLED=true
PII_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,US_SSN,IP_ADDRESS,PERSON,LOCATION

# ----- Context window -----
CONTEXT_TURN_LIMIT=12
PREVIEW_MAX_CHARS=500
